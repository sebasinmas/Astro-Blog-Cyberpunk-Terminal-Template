---
import arrowUpRight from '../assets/icons/arrow-up-right-18.svg';
import SectionHeading from './SectionHeading.astro';

const channels = [
	{ label: 'EMAIL', text: 'sebasinmascontacto@gmail.com', href: 'mailto:sebasinmascontacto@gmail.com', external: false },
	{ label: 'GITHUB', text: 'github.com/sebasinmas', href: 'https://github.com/sebasinmas', external: true },
	{
		label: 'LINKEDIN',
		text: 'Perfil profesional',
		href: 'https://www.linkedin.com/in/sebastianbeni',
		external: true,
	},
];
---

<div class="m-container">
<section class="contact" id="contact" aria-labelledby="contact-heading">
	<SectionHeading index="03" title="Contacto" meta="CANALES DIRECTOS" id="contact-heading" />

	<div class="content">
		<div class="invitation" data-reveal>
			<p class="lead">Sigamos la conversación.</p>
			<p class="copy">
				Si quieres ponerte en contacto conmigo, puedes hacerlo a través de mi email o mis redes sociales.
			</p>
		</div>
		<ul class="channels">
			{
				channels.map((c) => (
					<li data-reveal>
						<a
							class="channel"
							href={c.href}
							target={c.external ? '_blank' : undefined}
							rel={c.external ? 'noreferrer' : undefined}
						>
							<span class="label">{c.label}</span>
							<span class="value">{c.text}</span>
							<img class="arrow" src={arrowUpRight.src} width="18" height="18" alt="" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<div class="rule" role="presentation" data-rule></div>
</div>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		gap: 36px;
		padding-bottom: 80px;
	}

	.content {
		display: flex;
		align-items: flex-start;
		gap: 100px;
	}

	.invitation {
		display: flex;
		flex: 0 0 470px;
		flex-direction: column;
		gap: 20px;
		padding-top: 18px;
	}

	.lead {
		margin: 0;
		font-size: clamp(2rem, 3.6vw, 2.75rem);
		font-weight: 500;
		line-height: 1.15;
		color: var(--m-text);
	}

	.copy {
		margin: 0;
		font-size: 16px;
		line-height: 1.7;
		color: var(--m-muted);
	}

	.channels {
		flex: 1 1 0;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.channel {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-block: 22px;
		border-bottom: 1px solid var(--m-line);
	}

	.label {
		flex: 0 0 78px;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-dim);
	}

	.value {
		flex: 1 1 0;
		min-width: 0;
		font-size: 17px;
		color: var(--m-accent);
		overflow-wrap: anywhere;
		transition: color 0.2s ease;
	}

	.arrow {
		flex: none;
		transition: transform 0.25s ease;
	}

	.channel:hover .value,
	.channel:focus-visible .value {
		color: var(--m-text);
	}

	.channel:hover .arrow,
	.channel:focus-visible .arrow {
		transform: translate(3px, -3px);
	}

	.rule {
		height: 1px;
		background: var(--m-line);
		transform-origin: left;
	}

	@media (max-width: 900px) {
		.content {
			flex-direction: column;
			align-items: stretch;
			gap: 32px;
		}

		.invitation {
			flex-basis: auto;
			padding-top: 0;
		}
	}

	@media (max-width: 480px) {
		.channel {
			gap: 12px;
		}

		.label {
			flex-basis: 64px;
		}

		.value {
			font-size: 15px;
		}
	}
</style>
