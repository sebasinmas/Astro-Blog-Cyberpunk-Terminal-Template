---
interface Props {
	text: string;
	class?: string;
	durationSec?: number;
}

const { text, class: className, durationSec = 2.8 } = Astro.props;
const steps = Math.max([...text].length, 1);
---

<span class:list={['tw-root', className]} style={`--tw-steps: ${steps}; --tw-duration: ${durationSec}s`}>
	<span class="tw-measure" aria-hidden="true">{text}</span>
	<span class="tw-line">{text}</span>
</span>

<style>
	/* Grid: capa invisible define el ancho real del texto; la capa visible revela con width % (sin cortes por 1ch). */
	.tw-root {
		display: inline-grid;
		vertical-align: bottom;
		max-width: 100%;
	}

	.tw-measure,
	.tw-line {
		grid-area: 1 / 1;
		font-family: var(--font-mono);
		font-size: inherit;
		line-height: inherit;
		white-space: nowrap;
	}

	.tw-measure {
		visibility: hidden;
		pointer-events: none;
		user-select: none;
	}

	.tw-line {
		overflow: hidden;
		width: 0;
		min-width: 0;
		border-right: 2px solid var(--color-secondary);
		animation:
			tw-reveal var(--tw-duration) steps(var(--tw-steps), end) forwards,
			tw-caret 0.85s steps(1, end) infinite;
	}

	@keyframes tw-reveal {
		to {
			width: 100%;
		}
	}

	@keyframes tw-caret {
		50% {
			border-color: transparent;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tw-line {
			width: 100%;
			overflow: visible;
			border-right: none;
			animation: none;
		}
	}
</style>
