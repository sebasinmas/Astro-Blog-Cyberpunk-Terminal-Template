---
interface Props {
	text: string;
	class?: string;
	durationSec?: number;
}

const { text, class: className, durationSec = 2.8 } = Astro.props;
const steps = Math.max([...text].length, 1);
---

<span class:list={['tw-root', className]} style={`--tw-steps: ${steps}; --tw-duration: ${durationSec}s`}>
	<span class="tw-measure" aria-hidden="true">{text}</span>
	<span class="tw-line">{text}</span>
</span>

<style>
	/* Grid: capa invisible define el ancho real del texto; la capa visible revela con width % (sin cortes por 1ch). */
	.tw-root {
		display: inline-grid;
		vertical-align: bottom;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		box-sizing: border-box;
	}

	.tw-measure,
	.tw-line {
		grid-area: 1 / 1;
		font-family: var(--font-mono);
		font-size: inherit;
		line-height: inherit;
		white-space: nowrap;
	}

	.tw-measure {
		visibility: hidden;
		pointer-events: none;
		user-select: none;
	}

	.tw-line {
		overflow: hidden;
		width: 0;
		min-width: 0;
		border-right: 3px solid var(--color-neon-green);
		box-shadow: 2px 0 8px rgba(57, 255, 20, 0.35);
		animation:
			tw-reveal var(--tw-duration) steps(var(--tw-steps), end) forwards,
			tw-caret 0.85s steps(1, end) infinite;
	}

	/*
		Móvil: el typewriter (nowrap + width 0→100%) compite con un ancho estrecho y queda invisible o “aplastado”.
		Ahí mostramos el texto completo, varias líneas, sin animación.
	*/
	@media (max-width: 767px) {
		.tw-root {
			display: block;
			width: 100%;
			vertical-align: unset;
		}

		.tw-measure {
			display: none;
		}

		.tw-line {
			display: block;
			width: 100%;
			min-width: 0;
			overflow: visible;
			white-space: normal;
			overflow-wrap: anywhere;
			word-break: break-word;
			border-right: none;
			box-shadow: none;
			animation: none;
			line-height: 1.45;
		}
	}

	@keyframes tw-reveal {
		to {
			width: 100%;
		}
	}

	@keyframes tw-caret {
		50% {
			border-color: transparent;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tw-line {
			width: 100%;
			overflow: visible;
			border-right: none;
			animation: none;
		}
	}
</style>
