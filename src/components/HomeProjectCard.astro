---
import Image from 'astro/components/Image.astro';

interface Props {
	title: string;
	description: string;
	tags: readonly string[];
	image: string;
}

const { title, description, tags, image } = Astro.props;
---

<article class="card pixel-corners">
	<div class="shine" aria-hidden="true"></div>
	<div class="corner-glow" aria-hidden="true"></div>
	<div class="thumb">
		<Image src={image} alt={title} loading="eager" width="800" height="450" />
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((t) => <li>{t}</li>)}
		</ul>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
		background: color-mix(in srgb, var(--color-surface) 65%, transparent);
		backdrop-filter: blur(12px);
		overflow: hidden;
		border-radius: 0;
		transition:
			border-color 0.22s ease,
			transform 0.28s ease,
			box-shadow 0.22s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: border-color 0.22s ease;
		}
	}

	.card:hover {
		border-color: color-mix(in srgb, var(--color-secondary) 65%, var(--color-primary));
		box-shadow:
			0 0 28px rgba(5, 217, 232, 0.12),
			0 0 48px rgba(255, 42, 109, 0.08);
		transform: translateY(-3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover {
			transform: none;
		}
	}

	.corner-glow {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		z-index: 3;
		background:
			linear-gradient(135deg, rgba(255, 42, 109, 0.2) 0, transparent 42%),
			linear-gradient(315deg, rgba(5, 217, 232, 0.15) 0, transparent 42%);
		transition: opacity 0.25s ease;
	}

	.card:hover .corner-glow {
		opacity: 1;
	}

	.shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			transparent,
			color-mix(in srgb, var(--color-surface-lowest) 85%, transparent)
		);
		pointer-events: none;
		z-index: 0;
	}

	.thumb {
		position: relative;
		z-index: 1;
		height: 12rem;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 25%, var(--color-outline-variant));
		overflow: hidden;
		border-radius: 0;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.7;
		filter: saturate(0.85) contrast(1.02);
		transition:
			opacity 0.35s ease,
			transform 0.45s ease,
			filter 0.35s ease;
	}

	.card:hover .thumb img {
		opacity: 1;
		filter: saturate(1.1) contrast(1.05);
		transform: scale(1.05);
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover .thumb img {
			transform: none;
		}
	}

	.body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	h3 {
		font-family: var(--font-display);
		font-size: 1.28rem;
		color: var(--color-secondary);
		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;
	}

	.card:hover h3 {
		color: var(--color-on-surface);
		text-shadow:
			-1px 0 0 rgba(255, 42, 109, 0.65),
			1px 0 0 rgba(5, 217, 232, 0.55),
			0 0 14px rgba(57, 255, 20, 0.25);
	}

	p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-on-surface-variant);
		flex: 1;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		padding: 0.2rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--color-primary) 45%, var(--color-outline-variant));
		background: var(--color-container-high);
		color: var(--color-neon-green);
		text-shadow: 0 0 6px rgba(57, 255, 20, 0.25);
		border-radius: 0;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.card:hover .tags li {
		border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-primary));
	}
</style>
