---
import Image from 'astro/components/Image.astro';

interface Props {
	title: string;
	description: string;
	tags: readonly string[];
	image: string;
}

const { title, description, tags, image } = Astro.props;
---

<article class="card pixel-corners">
	<div class="shine" aria-hidden="true"></div>
	<div class="thumb">
		<Image src={image} alt={title} loading="eager" width="800" height="450" />
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p>{description}</p>
		<ul class="tags">
			{tags.map((t) => <li>{t}</li>)}
		</ul>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 35%, transparent);
		background: color-mix(in srgb, var(--color-surface) 50%, transparent);
		backdrop-filter: blur(14px);
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			transform 0.25s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: border-color 0.2s ease;
		}
	}

	.card:hover {
		border-color: color-mix(in srgb, var(--color-secondary) 45%, var(--color-outline-variant));
	}

	.shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-surface-lowest) 80%, transparent));
		pointer-events: none;
		z-index: 0;
	}

	.thumb {
		position: relative;
		z-index: 1;
		height: 12rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 25%, transparent);
		overflow: hidden;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.65;
		transition:
			opacity 0.35s ease,
			transform 0.45s ease;
	}

	.card:hover .thumb img {
		opacity: 1;
		transform: scale(1.04);
	}

	@media (prefers-reduced-motion: reduce) {
		.card:hover .thumb img {
			transform: none;
		}
	}

	.body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	h3 {
		font-size: 1.15rem;
		color: var(--color-secondary);
		transition: color 0.2s ease;
	}

	.card:hover h3 {
		color: var(--color-primary);
	}

	p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-on-surface-variant);
		flex: 1;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		padding: 0.2rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 35%, transparent);
		background: var(--color-container-high);
		color: var(--color-on-surface);
	}
</style>
