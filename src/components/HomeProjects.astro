---
import Image from 'astro/components/Image.astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import { resolveProjectImage } from '../utils/resolveProjectImage';
import SectionHeading from './SectionHeading.astro';

const projects: CollectionEntry<'projects'>[] = (await getCollection('projects')).sort(
	(a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => a.data.order - b.data.order,
);
---

<section class="projects m-container" id="projects" aria-labelledby="projects-heading">
	<SectionHeading index="01" title="Proyectos" meta="DESARROLLO / SELECCIÓN" id="projects-heading" />

	{
		projects.map((entry: CollectionEntry<'projects'>) => {
			const resolved = resolveProjectImage(entry.data.image);
			return (
				<a class="featured" href={`/projects/${entry.id}/`} data-reveal>
					<div class="preview">
						<div class="chrome" aria-hidden="true">
							<span class="controls">
								<i />
								<i />
								<i />
							</span>
							<span class="chrome-label">{entry.data.title.toUpperCase()} / VISTA DEL PROYECTO</span>
						</div>
						<div class="shot">
							{typeof resolved === 'string' ? (
								<Image src={resolved} alt="" loading="lazy" width={1040} height={480} />
							) : (
								<Image src={resolved} alt="" loading="lazy" width={1040} />
							)}
						</div>
					</div>
					<div class="details">
						{entry.data.kicker && <p class="kicker">{entry.data.kicker}</p>}
						<h3>{entry.data.title}</h3>
						<p class="description">{entry.data.description}</p>
						<ul class="stack" aria-label="Tecnologías">
							{entry.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					</div>
				</a>
			);
		})
	}

	<div class="rule" role="presentation" data-rule></div>
</section>

<style>
	.projects {
		display: flex;
		flex-direction: column;
		gap: 36px;
		padding-block: 72px;
	}

	.featured {
		display: flex;
		align-items: center;
		gap: 48px;
		padding: 32px;
		background: var(--m-surface);
		border: 1px solid var(--m-line);
		border-radius: 8px;
		transition: border-color 0.25s ease;
	}

	.featured:hover {
		border-color: color-mix(in srgb, var(--m-accent) 55%, var(--m-line));
	}

	.preview {
		flex: 0 0 520px;
		width: 520px;
		overflow: hidden;
		border: 1px solid var(--m-line);
		border-radius: 4px;
	}

	.chrome {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 36px;
		padding-inline: 14px;
		background: var(--m-surface-2);
	}

	.controls {
		display: flex;
		gap: 5px;
	}

	.controls i {
		width: 5px;
		height: 5px;
		border-radius: 3px;
		background: var(--m-dim);
	}

	.chrome-label {
		font-family: var(--m-font-code);
		font-size: 10px;
		color: var(--m-muted);
		white-space: nowrap;
	}

	.shot {
		height: 240px;
		overflow: hidden;
		background: var(--m-surface);
	}

	.shot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.6s ease;
	}

	.featured:hover .shot :global(img) {
		transform: scale(1.04);
	}

	.details {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
		min-width: 0;
	}

	.kicker {
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-accent);
	}

	h3 {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		line-height: normal;
		color: var(--m-text);
	}

	.description {
		margin: 0;
		font-size: 16px;
		line-height: 1.65;
		color: var(--m-muted);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: 6px 9px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-muted);
	}

	.rule {
		height: 1px;
		background: var(--m-line);
		transform-origin: left;
	}

	@media (max-width: 1100px) {
		.featured {
			flex-direction: column;
			align-items: stretch;
			gap: 32px;
		}

		.preview {
			flex-basis: auto;
			width: 100%;
		}
	}

	@media (max-width: 640px) {
		.projects {
			padding-block: 48px;
		}

		.featured {
			padding: 16px;
		}

		.shot {
			height: 200px;
		}

		.chrome-label {
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}
</style>
