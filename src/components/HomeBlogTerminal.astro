---
import { type CollectionEntry, getCollection } from 'astro:content';
import TypewriterText from './TypewriterText.astro';

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog'))
	.sort(
		(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	)
	.slice(0, 3);

const titleTw = '$ ./tail_syslog.sh --limit 3';
---

<section class="terminal-wrap container" id="blog" aria-labelledby="terminal-heading">
	<div class="terminal pixel-corners glow-shadow">
		<div class="terminal-head">
			<svg class="icon-terminal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6v-2zm0 4h8v2H6v-2z"
				></path>
			</svg>
			<h2 id="terminal-heading">
				<TypewriterText text={titleTw} durationSec={1.8} />
			</h2>
			<span class="badge" title="Si parpadea, es culpa del VHS">REC</span>
		</div>
		<ul class="log">
			{
				posts.map((post) => (
					<li>
						<time datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('es-ES')}
						</time>
						<a href={`/blog/${post.id}/`} class="line" data-gag={`sha1:${post.id.slice(0, 6)}…`}>
							<span class="prompt">&gt;</span>
							<span class="title">{post.data.title}</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="cursor-line" aria-hidden="true">
			<span class="prompt-static">root@neon:~$</span>
			<span class="cursor-block"></span>
		</p>
	</div>
</section>

<style>
	.terminal-wrap {
		margin-top: 2.5rem;
	}

	.terminal {
		position: relative;
		width: 100%;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-primary) 35%, var(--color-secondary));
		background: color-mix(in srgb, var(--color-surface-lowest) 94%, transparent);
		backdrop-filter: blur(14px);
		overflow: hidden;
		border-radius: 0;
		box-shadow:
			inset 0 0 60px rgba(5, 217, 232, 0.04),
			0 0 30px rgba(255, 42, 109, 0.06);
	}

	.terminal::before {
		content: '';
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			0deg,
			transparent,
			transparent 2px,
			rgba(0, 0, 0, 0.12) 2px,
			rgba(0, 0, 0, 0.12) 3px
		);
		pointer-events: none;
		opacity: 0.4;
	}

	.terminal-head {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px dashed color-mix(in srgb, var(--color-secondary) 45%, transparent);
		flex-wrap: wrap;
	}

	.icon-terminal {
		display: block;
		width: 1.35rem;
		height: 1.35rem;
		flex-shrink: 0;
		color: var(--color-neon-green);
		filter: drop-shadow(0 0 6px rgba(57, 255, 20, 0.45));
	}

	h2 {
		flex: 1;
		min-width: 0;
		font-size: 1.05rem;
		color: var(--color-on-surface);
		min-height: 1.3em;
		font-family: var(--font-mono);
		font-weight: 600;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.15em;
		padding: 0.2rem 0.45rem;
		border: 1px solid var(--color-primary);
		color: var(--color-primary);
		background: rgba(255, 42, 109, 0.12);
		animation: rec-pulse 1.2s steps(1, end) infinite;
		border-radius: 0;
	}

	@keyframes rec-pulse {
		50% {
			opacity: 0.55;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.badge {
			animation: none;
		}
	}

	.log {
		position: relative;
		z-index: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.log li {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: baseline;
	}

	time {
		flex: 0 0 6.5rem;
		color: var(--color-neon-muted);
	}

	.line {
		position: relative;
		display: inline-flex;
		gap: 0.35rem;
		color: var(--color-secondary);
		text-decoration: none;
		transition:
			color 0.15s ease,
			text-shadow 0.15s ease;
	}

	.line:hover {
		color: var(--color-neon-green);
		text-shadow: 0 0 10px rgba(57, 255, 20, 0.45);
	}

	@media (min-width: 768px) {
		.line:hover::after {
			content: attr(data-gag);
			position: absolute;
			left: 0;
			top: calc(100% + 0.25rem);
			font-size: 0.58rem;
			color: var(--color-neon-dim);
			pointer-events: none;
			white-space: nowrap;
		}
	}

	.prompt {
		flex-shrink: 0;
		color: var(--color-primary);
	}

	.title {
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-secondary) 50%, transparent);
		text-underline-offset: 3px;
	}

	.cursor-line {
		position: relative;
		z-index: 1;
		margin: 1rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-neon-green);
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	.prompt-static {
		color: var(--color-neon-dim);
	}

	.cursor-block {
		display: inline-block;
		width: 0.55rem;
		height: 1rem;
		background: var(--color-neon-green);
		box-shadow: 0 0 10px rgba(57, 255, 20, 0.5);
		animation: blink 1s steps(1, end) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor-block {
			animation: none;
			opacity: 1;
		}
	}
</style>
