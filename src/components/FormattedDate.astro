---
interface Props {
	date: Date;
}

const { date } = Astro.props;

/** Fechas solo-día del frontmatter (`pubDate: '2025-04-20'`) vienen como UTC 00:00; sin esto, en TZ detrás de UTC el día “cae” al anterior. */
const isoDay = `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
---

<time datetime={isoDay}>
	{
		date.toLocaleDateString('es-ES', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
