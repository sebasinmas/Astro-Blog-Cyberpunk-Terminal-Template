---
const year = new Date().getFullYear();
---

<footer class="footer-wrap" id="footer">
	<div class="footer-inner container">
		<div class="brand">SebaSinMas</div>
		<p class="copy">&copy; {year} SebaSinMas — Portfolio técnico</p>
		<ul class="links">
			<li><a href="https://github.com" target="_blank" rel="noreferrer">GitHub</a></li>
			<li><a href="https://linkedin.com" target="_blank" rel="noreferrer">LinkedIn</a></li>
			<li><a href="https://github.com" target="_blank" rel="noreferrer">Source</a></li>
		</ul>
	</div>
</footer>

<style>
	.footer-wrap {
		margin-top: 3rem;
		margin-bottom: 2rem;
		padding-inline: var(--space-page);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		padding: 2rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 40%, transparent);
		background: color-mix(in srgb, var(--color-surface-lowest) 60%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: 0 0 30px rgba(34, 211, 238, 0.1);
		clip-path: var(--radius-pixel);
	}

	@media (min-width: 768px) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
		}
	}

	.brand {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-primary);
	}

	.copy {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-on-surface-variant);
		text-align: center;
	}

	.links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.links a {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-on-surface-variant);
	}

	.links a:hover {
		color: var(--color-secondary);
	}
</style>
