---
---

<header class="header-wrap">
	<nav class="nav container" aria-label="Principal">
		<a class="brand" href="/" data-cmd="cd ~">SebaSinMas</a>

		<details class="mobile-menu">
			<summary class="menu-toggle">
				<span class="sr-only">Abrir menú</span>
				<span class="material-symbols-outlined" aria-hidden="true">menu</span>
			</summary>
			<div class="mobile-links">
				<a href="/#projects" class="nav-link" data-cmd="./portfolio.sh --list">Proyectos</a>
				<a href="/blog/" class="nav-link" data-cmd="cat ./blog/*.md">Blog</a>
				<a href="/#contact" class="nav-link" data-cmd="mail —compose">Contacto</a>
			</div>
		</details>

		<div class="desktop-links">
			<a href="/#projects" class="nav-link" data-cmd="./portfolio.sh --list">Proyectos</a>
			<a href="/blog/" class="nav-link" data-cmd="cat ./blog/*.md">Blog</a>
			<a href="/#contact" class="nav-link" data-cmd="mail —compose">Contacto</a>
		</div>

		<div class="actions">
			<a href="/blog/" class="icon-btn" aria-label="Ir al blog (vista terminal)" title="RUN: blog_viewer.bin">
				<span class="material-symbols-outlined" aria-hidden="true">terminal</span>
			</a>
			<a
				href="https://github.com/sebasinmas"
				class="icon-btn"
				target="_blank"
				rel="noreferrer"
				aria-label="Perfil en GitHub"
				title="RUN: gh_clone.sh"
			>
				<svg class="icon-github" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.header-wrap {
		position: sticky;
		top: 0.5rem;
		z-index: 50;
		padding-inline: var(--space-page);
		margin-top: 0.5rem;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 55%, var(--color-primary));
		background: color-mix(in srgb, var(--color-surface-lowest) 92%, transparent);
		backdrop-filter: blur(14px);
		box-shadow: var(--glow);
		border-radius: 0;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.35rem;
		line-height: 1;
		color: var(--color-secondary);
		text-shadow:
			0 0 10px rgba(5, 217, 232, 0.5),
			0 0 24px rgba(255, 42, 109, 0.25);
		position: relative;
		transition:
			color 0.2s ease,
			text-shadow 0.2s ease;
	}

	.brand:hover {
		color: var(--color-primary);
		text-shadow:
			0 0 12px rgba(255, 42, 109, 0.55),
			0 0 28px rgba(5, 217, 232, 0.25);
	}

	@media (min-width: 768px) {
		.brand:hover::after {
			content: attr(data-cmd);
			position: absolute;
			left: 0;
			top: calc(100% + 0.35rem);
			font-family: var(--font-mono);
			font-size: 0.62rem;
			font-weight: 400;
			color: var(--color-neon-dim);
			text-shadow: none;
			letter-spacing: 0.04em;
			white-space: nowrap;
			pointer-events: none;
		}
	}

	.desktop-links {
		display: none;
		align-items: center;
		gap: 1.5rem;
	}

	.desktop-links .nav-link {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--color-on-surface-variant);
		position: relative;
		transition:
			color 0.15s ease,
			text-shadow 0.15s ease;
	}

	.desktop-links .nav-link:hover {
		color: var(--color-neon-green);
		text-shadow: 0 0 8px rgba(57, 255, 20, 0.45);
	}

	@media (min-width: 768px) {
		.desktop-links .nav-link:hover::after {
			content: '[' attr(data-cmd) ']';
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
			top: calc(100% + 0.5rem);
			font-size: 0.58rem;
			color: var(--color-neon-dim);
			text-shadow: none;
			white-space: nowrap;
			opacity: 1;
			pointer-events: none;
			max-width: 14rem;
			overflow: hidden;
			text-overflow: ellipsis;
		}
	}

	.mobile-menu {
		position: relative;
		margin-inline: auto;
	}

	.mobile-menu summary {
		list-style: none;
		cursor: pointer;
		color: var(--color-primary);
		transition: color 0.15s ease;
	}

	.mobile-menu summary:hover {
		color: var(--color-secondary);
		text-shadow: 0 0 10px rgba(5, 217, 232, 0.45);
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.menu-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 0.35rem;
	}

	.mobile-links {
		position: absolute;
		right: 0;
		top: calc(100% + 0.5rem);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 12rem;
		padding: 0.75rem;
		background: var(--color-surface-lowest);
		border: 1px solid var(--color-secondary);
		border-radius: 0;
		box-shadow: 0 0 20px rgba(5, 217, 232, 0.15);
	}

	.mobile-links a {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		min-height: 44px;
		padding: 0.65rem 0.25rem;
		display: flex;
		align-items: center;
		color: var(--color-on-surface-variant);
		transition: color 0.15s ease;
	}

	.mobile-links a:hover {
		color: var(--color-neon-green);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
	}

	.icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 0.35rem;
		color: inherit;
		border: 1px solid transparent;
		border-radius: 0;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.icon-btn:hover {
			color: var(--color-bg);
			background: var(--color-secondary);
			border-color: var(--color-secondary);
			box-shadow: 0 0 14px rgba(5, 217, 232, 0.45);
		}
	}

	.icon-github {
		display: block;
		width: 22px;
		height: 22px;
	}

	@media (min-width: 768px) {
		.mobile-menu {
			display: none;
		}

		.desktop-links {
			display: flex;
		}
	}
</style>
