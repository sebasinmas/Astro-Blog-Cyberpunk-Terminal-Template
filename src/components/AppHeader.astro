---
---

<header class="header-wrap">
	<nav class="nav container" aria-label="Principal">
		<a class="brand" href="/">SebaSinMas</a>

		<details class="mobile-menu">
			<summary class="menu-toggle">
				<span class="sr-only">Abrir menú</span>
				<span class="material-symbols-outlined" aria-hidden="true">menu</span>
			</summary>
			<div class="mobile-links">
				<a href="#projects">Proyectos</a>
				<a href="/blog/">Blog</a>
				<a href="#contact">Contacto</a>
			</div>
		</details>

		<div class="desktop-links">
			<a href="#projects">Proyectos</a>
			<a href="/blog/">Blog</a>
			<a href="#contact">Contacto</a>
		</div>

		<div class="actions">
			<a href="/blog/" class="icon-btn" aria-label="Ir al blog (vista terminal)">
				<span class="material-symbols-outlined" aria-hidden="true">terminal</span>
			</a>
			<a
				href="https://github.com"
				class="icon-btn"
				target="_blank"
				rel="noreferrer"
				aria-label="Perfil en GitHub"
			>
				<span class="material-symbols-outlined" aria-hidden="true">share</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.header-wrap {
		position: sticky;
		top: 0.5rem;
		z-index: 50;
		padding-inline: var(--space-page);
		margin-top: 0.5rem;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 50%, transparent);
		background: color-mix(in srgb, var(--color-surface) 80%, transparent);
		backdrop-filter: blur(16px);
		box-shadow: var(--glow);
		clip-path: var(--radius-pixel);
	}

	.brand {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-secondary);
	}

	.desktop-links {
		display: none;
		align-items: center;
		gap: 1.5rem;
	}

	.desktop-links a {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-on-surface-variant);
	}

	.desktop-links a:hover {
		color: var(--color-secondary);
	}

	.mobile-menu {
		position: relative;
		margin-inline: auto;
	}

	.mobile-menu summary {
		list-style: none;
		cursor: pointer;
		color: var(--color-primary);
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.menu-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
	}

	.mobile-links {
		position: absolute;
		right: 0;
		top: calc(100% + 0.5rem);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 12rem;
		padding: 0.75rem;
		background: var(--color-surface-lowest);
		border: 1px solid var(--color-outline-variant);
		clip-path: var(--radius-pixel);
	}

	.mobile-links a {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.35rem 0;
		color: var(--color-on-surface-variant);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-primary);
	}

	.icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
		color: inherit;
	}

	.icon-btn:hover {
		color: var(--color-secondary);
	}

	@media (min-width: 768px) {
		.mobile-menu {
			display: none;
		}

		.desktop-links {
			display: flex;
		}
	}
</style>
