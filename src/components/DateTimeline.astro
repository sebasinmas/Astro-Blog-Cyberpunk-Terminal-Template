---
import FormattedDate from './FormattedDate.astro';

interface Props {
	/** Fecha de creación (`pubDate`). */
	created: Date;
	/** Fecha de la última actualización (`updatedDate`); se ignora si no es posterior a la creación. */
	updated?: Date;
	/**
	 * `timeline`: línea de tiempo con nodos (cabecera de artículo).
	 * `inline`: fecha de creación y tag de actualización en una fila (listados).
	 * `stacked`: igual que `inline`, pero apilado (columnas de fecha estrechas).
	 */
	variant?: 'timeline' | 'inline' | 'stacked';
}

const { created, updated, variant = 'timeline' } = Astro.props;

// Solo se considera editado si la actualización es posterior a la publicación.
const edited = updated && updated.getTime() > created.getTime() ? updated : undefined;
const timeline = variant === 'timeline';
---

<span class:list={['dates', `dates--${variant}`]}>
	<span class="item created">
		{timeline && <span class="node" aria-hidden="true" />}
		{timeline && <span class="label">Creado</span>}
		<FormattedDate date={created} />
	</span>
	{timeline && edited && <span class="track" aria-hidden="true" />}
	{
		edited && (
			<span class="item updated" title="Contenido actualizado después de su publicación">
				<span class="node" aria-hidden="true" />
				<span class="label">Actualizado</span>
				<FormattedDate date={edited} />
			</span>
		)
	}
</span>

<style>
	.dates {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-dim);
		white-space: nowrap;
	}

	.item {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.label {
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Nodo cuadrado, igual que el indicador `signal` del sitio */
	.node {
		flex: none;
		box-sizing: border-box;
		width: 7px;
		height: 7px;
		border: 1px solid var(--m-dim);
	}

	/* La actualización es el "tag de edición": borde y relleno de acento */
	.updated {
		padding: 4px 8px;
		border: 1px solid color-mix(in srgb, var(--m-accent) 45%, transparent);
		border-radius: 4px;
		background: color-mix(in srgb, var(--m-accent) 8%, transparent);
		color: var(--m-muted);
	}

	.updated .label {
		color: var(--m-accent);
	}

	.updated .node {
		border-color: var(--m-accent);
		background: var(--m-accent);
	}

	.created .label {
		color: var(--m-muted);
	}

	/* Conector entre ambos nodos: de neutro a acento */
	.track {
		flex: none;
		width: 36px;
		height: 1px;
		margin-inline: -4px;
		background: linear-gradient(90deg, var(--m-line), var(--m-accent));
	}

	/* Listados: la fecha de creación es la principal; la actualización, un tag discreto */
	.dates--inline,
	.dates--stacked {
		text-transform: uppercase;
	}

	.dates--inline .updated,
	.dates--stacked .updated {
		padding: 2px 6px;
		font-size: 11px;
	}

	.dates--inline .updated .label,
	.dates--stacked .updated .label {
		font-size: 9px;
	}

	.dates--stacked {
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	@media (max-width: 560px) {
		/* La línea de tiempo pasa a vertical cuando no cabe en una fila */
		.dates--timeline {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
		}

		.dates--timeline .track {
			width: 1px;
			height: 14px;
			margin: 0 0 0 3px;
			background: linear-gradient(180deg, var(--m-line), var(--m-accent));
		}
	}
</style>
