---
import TypewriterText from './TypewriterText.astro';
import pfp from '../assets/pfp.jpg';
import pfp2 from '../assets/pfp2.png';
import Image from 'astro/components/Image.astro';
const eyebrow = 'SISTEMA EN LÍNEA // USUARIO: SebaSinMas // CLEARANCE: VHS-1986';
---

<section class="hero container glow-shadow pixel-corners" aria-labelledby="hero-title">
	<div class="glow-blob glow-blob-a" aria-hidden="true"></div>
	<div class="glow-blob glow-blob-b" aria-hidden="true"></div>
	<div class="hero-copy">
		<p class="eyebrow">
			<TypewriterText text={eyebrow} durationSec={3.2} />
		</p>
		<h1 id="hero-title" class="text-phosphor">
			Software engineer, estudiante y <span class="accent">gamer</span><span class="heading-caret" aria-hidden="true"></span>
		</h1>
		<p class="lead">
			Desarrollador de software, estudiante, gamer y amante de la tecnología.
		</p>
		<div class="cta">
			<a class="btn btn-magenta pixel-corners" href="/#projects" data-gag="RUN portfolio.exe /fullscreen"
				>Ver proyectos</a
			>
			<a class="btn btn-cyan pixel-corners" href="/blog/" data-gag="LOAD blog_tape.vhs">Leer blog</a>
		</div>
	</div>
	<figure class="hero-figure">
		<Image src={pfp} alt="SebaSinMas" width="256" height="256" loading="eager" />
		<Image src={pfp2} alt="SebaSinMas pixel art" width="256" height="256" loading="eager" />
	</figure>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 2rem);
		margin-top: clamp(1rem, 3vw, 2rem);
		padding: clamp(1rem, 4vw, 2rem);
		padding-bottom: clamp(1.25rem, 5vw, 2rem);
		overflow: visible;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 40%, var(--color-primary));
		background: color-mix(in srgb, var(--color-surface) 75%, transparent);
		backdrop-filter: blur(16px);
		border-radius: 0;
	}

	/* Solo escritorio: recorta halos decorativos que sobresalen */
	@media (min-width: 900px) {
		.hero {
			overflow: hidden;
			flex-direction: row;
			align-items: center;
		}
	}

	.glow-blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(72px);
		pointer-events: none;
		z-index: 0;
		mix-blend-mode: screen;
	}

	.glow-blob-a {
		top: -2rem;
		right: -1rem;
		width: 18rem;
		height: 18rem;
		background: rgba(255, 42, 109, 0.22);
	}

	.glow-blob-b {
		bottom: -3rem;
		left: -2rem;
		width: 14rem;
		height: 14rem;
		background: rgba(5, 217, 232, 0.14);
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: clamp(0.62rem, 1.8vw, 0.72rem);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-neon-amber);
		min-height: 1.5em;
		overflow-x: auto;
		overflow-y: visible;
		-webkit-overflow-scrolling: touch;
		text-shadow: 0 0 8px rgba(255, 176, 0, 0.35);
	}

	h1 {
		font-size: clamp(1.85rem, 4vw, 3.1rem);
		line-height: 1.12;
		color: var(--color-on-surface);
	}

	.heading-caret {
		display: inline-block;
		width: 0.45rem;
		height: 0.95em;
		margin-left: 0.2rem;
		vertical-align: baseline;
		background: var(--color-neon-green);
		box-shadow: 0 0 12px rgba(57, 255, 20, 0.55);
		animation: caret-blink 1.05s steps(1, end) infinite;
	}

	@keyframes caret-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.heading-caret {
			animation: none;
			opacity: 1;
		}
	}

	.accent {
		color: var(--color-primary);
		text-shadow:
			0 0 10px rgba(255, 42, 109, 0.55),
			0 0 22px rgba(5, 217, 232, 0.2);
	}

	.lead {
		margin: 0;
		max-width: 38rem;
		font-size: clamp(0.95rem, 2.8vw, 1.02rem);
		line-height: 1.65;
		color: var(--color-on-surface-variant);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		row-gap: 0.85rem;
		margin-top: 0.5rem;
		margin-bottom: 0;
		padding-top: 0.35rem;
		padding-bottom: 0.35rem;
		width: 100%;
		box-sizing: border-box;
	}

	@media (max-width: 899px) {
		.cta {
			flex-direction: column;
			align-items: stretch;
			padding-inline: 0.25rem;
			gap: 1rem;
			margin-top: 0.75rem;
		}

		.cta .btn {
			width: 100%;
			max-width: 100%;
			box-sizing: border-box;
			margin-inline: 0;
		}
	}

	.btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.25rem;
		min-height: 44px;
		font-family: var(--font-mono);
		font-size: clamp(0.72rem, 2.8vw, 0.8rem);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		cursor: pointer;
		background: transparent;
		border-radius: 0;
		transition:
			background 0.18s ease,
			color 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}

	.btn-magenta {
		border: 1px solid var(--color-primary);
		color: var(--color-primary);
	}

	.btn-cyan {
		border: 1px solid var(--color-secondary);
		color: var(--color-secondary);
	}

	@media (hover: hover) and (pointer: fine) {
		.btn-magenta:hover {
			background: var(--color-primary);
			color: var(--color-bg);
			box-shadow:
				0 0 20px rgba(255, 42, 109, 0.55),
				inset 0 0 20px rgba(5, 217, 232, 0.15);
		}

		.btn-cyan:hover {
			background: var(--color-secondary);
			color: var(--color-on-secondary-fixed);
			box-shadow: 0 0 22px rgba(5, 217, 232, 0.5);
		}
	}

	@media (min-width: 768px) and (hover: hover) and (pointer: fine) {
		.btn:hover::after {
			content: attr(data-gag);
			position: absolute;
			left: 0;
			top: calc(100% + 0.45rem);
			font-size: 0.58rem;
			font-weight: 400;
			text-transform: none;
			letter-spacing: 0.04em;
			color: var(--color-neon-dim);
			white-space: nowrap;
			pointer-events: none;
		}
	}

	.hero-figure {
		position: relative;
		width: min(100%, 256px);
		max-width: 256px;
		flex-shrink: 0;
		transition:
			transform 0.35s ease,
			filter 0.35s ease;
		overflow: hidden;
		z-index: 1;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 50%, transparent);
		box-shadow: 0 0 24px rgba(5, 217, 232, 0.12);
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}

	.hero-figure img:first-child {
		display: block;
		box-shadow: 0 50px 50px -48px rgba(0, 0, 0, 0.65);
		border-radius: 0;
		object-fit: cover;
		width: 100%;
		transition:
			filter 0.35s ease,
			transform 0.35s ease;
	}

	.hero-figure img:last-child {
		position: absolute;
		width: 100%;
		bottom: 0;
		left: 0;
		right: 0;
		margin: auto;
		transform: translateY(10%);
		opacity: 0;
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
		border-radius: 0;
	}

	/* Hover 3D / overlay: solo ratón o stylus real — en táctil :hover se queda “pegado” */
	@media (hover: hover) and (pointer: fine) {
		.hero-figure:hover {
			transform: perspective(1000px) rotateX(8deg) translateY(-6px) translateZ(0);
			filter: saturate(1.15) contrast(1.05);
		}

		.hero-figure::before {
			content: '';
			position: absolute;
			bottom: 0;
			width: 100%;
			height: 100%;
			background-image: linear-gradient(
				to bottom,
				transparent 10%,
				rgba(255, 42, 109, 0.15) 45%,
				rgba(5, 217, 232, 0.12) 70%,
				rgba(0, 0, 0, 0.85) 100%
			);
			opacity: 0;
			transition: opacity 0.35s ease;
			pointer-events: none;
			z-index: 2;
		}

		.hero-figure:hover::before {
			opacity: 1;
		}

		.hero-figure:hover img:first-child {
			filter: hue-rotate(-8deg);
		}

		.hero-figure:hover img:last-child {
			opacity: 1;
			transform: translateY(0%) perspective(0);
		}
	}

	/* Táctil (sin hover real): solo feedback :active al pulsar */
	@media (hover: none) {
		.hero-figure:active {
			transform: scale(0.98);
			transition: transform 0.12s ease;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-figure:active {
			transform: none;
		}
	}
</style>
