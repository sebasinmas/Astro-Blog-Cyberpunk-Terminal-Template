---
import Image from 'astro/components/Image.astro';
import pfp from '../assets/pfp.jpg';
import arrowRightDark from '../assets/icons/arrow-right-dark.svg';
import arrowRightLight from '../assets/icons/arrow-right-light.svg';
---

<div class="m-container">
<section class="hero" aria-labelledby="hero-title">
	<div class="narrative">
		<p class="focus" data-reveal data-hero>
			<span class="signal" aria-hidden="true"></span>
			DESARROLLO DE SOFTWARE / CIBERSEGURIDAD
		</p>
		<h1 id="hero-title">
			<span class="line" data-reveal data-hero>Software engineer.</span>
			<span class="line accent" data-reveal data-hero>Explorando la ciberseguridad.</span>
		</h1>
		<div class="bio" data-reveal data-hero>
			<p>
				Desarrollador de software, estudiante, gamer y apasionado por construir interfaces rápidas, estéticas y bien
				estructuradas.
			</p>
			<p>Hoy, con interés en la ciberseguridad y en entender cómo funcionan los sistemas.</p>
		</div>
		<div class="actions" data-reveal data-hero>
			<a class="action primary" href="/#projects">
				Ver proyectos
				<img src={arrowRightDark.src} width="18" height="18" alt="" />
			</a>
			<a class="action secondary" href="/blog/">
				Leer bitácora
				<img src={arrowRightLight.src} width="18" height="18" alt="" />
			</a>
		</div>
	</div>

	<aside class="identity" aria-label="Perfil personal" data-reveal data-hero>
		<div class="frame" data-achievement-anchor="hesoyam">
			<div class="portrait">
				<Image src={pfp} alt="Retrato de SebaSinMas" width={290} height={290} loading="eager" fetchpriority="high" />
			</div>
		</div>
		<p class="caption">
			<span class="handle">@sebasinmas</span>
			<span class="tag">PERFIL PERSONAL</span>
		</p>
		<p class="roles">Software engineer · Estudiante · Gamer</p>
	</aside>
</section>
<div class="rule" role="presentation" data-rule></div>
</div>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 100px;
		padding-block: 88px 80px;
	}

	.rule {
		height: 1px;
		background: var(--m-line);
		transform-origin: left;
	}

	.narrative {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 28px;
		min-width: 0;
	}

	.focus {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-accent);
	}

	.signal {
		width: 6px;
		height: 6px;
		background: var(--m-accent);
	}

	h1 {
		display: flex;
		flex-direction: column;
		width: 100%;
		font-size: clamp(2.5rem, 6.2vw + 0.5rem, 4.25rem);
		line-height: 1.12;
		color: var(--m-text);
		text-wrap: balance;
	}

	.line {
		display: block;
	}

	.accent {
		color: var(--m-accent);
		max-width: 11em;
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 650px;
		font-size: 17px;
		line-height: 1.65;
		color: var(--m-muted);
	}

	.bio p {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 4px;
	}

	.action {
		display: inline-flex;
		align-items: center;
		gap: 24px;
		height: 50px;
		padding-inline: 20px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-size: 14px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.action img {
		transition: transform 0.25s ease;
	}

	.action:hover img,
	.action:focus-visible img {
		transform: translateX(4px);
	}

	.primary {
		background: var(--m-accent);
		border-color: var(--m-accent);
		color: var(--m-on-accent);
	}

	.primary:hover {
		background: color-mix(in srgb, var(--m-accent) 82%, white);
		border-color: color-mix(in srgb, var(--m-accent) 82%, white);
		color: var(--m-on-accent);
	}

	.secondary {
		color: var(--m-text);
	}

	.secondary:hover {
		border-color: var(--m-accent);
		color: var(--m-text);
	}

	.identity {
		display: flex;
		flex: 0 0 310px;
		flex-direction: column;
		align-items: stretch;
		gap: 20px;
		width: 310px;
	}

	.frame {
		width: 310px;
		height: 310px;
		padding: 10px;
		border: 1px solid var(--m-line);
	}

	.portrait {
		width: 290px;
		height: 290px;
		overflow: hidden;
		background: var(--m-surface);
	}

	.portrait :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.frame:hover .portrait :global(img) {
		transform: scale(1.04);
	}

	.caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 0;
		font-family: var(--m-font-code);
		white-space: nowrap;
	}

	.handle {
		font-size: 12px;
		color: var(--m-text);
	}

	.tag {
		font-size: 11px;
		color: var(--m-dim);
	}

	.roles {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--m-muted);
	}

	@media (max-width: 1100px) {
		.hero {
			gap: 56px;
		}
	}

	@media (max-width: 900px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: 48px;
			padding-block: 56px 56px;
		}

		.identity {
			flex-basis: auto;
		}
	}

	@media (max-width: 380px) {
		.identity,
		.frame {
			width: 100%;
		}

		.frame {
			height: auto;
			aspect-ratio: 1;
		}

		.portrait {
			width: 100%;
			height: 100%;
		}
	}
</style>
