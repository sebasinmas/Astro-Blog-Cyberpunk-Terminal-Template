---
import TypewriterText from './TypewriterText.astro';
import pfp from '../assets/pfp.jpg';
import pfp2 from '../assets/pfp2.png';
import Image from 'astro/components/Image.astro';
const eyebrow = 'Sistema en línea // Usuario: SebaSinMas';
---

<section class="hero container glow-shadow pixel-corners" aria-labelledby="hero-title">
	<div class="glow-blob" aria-hidden="true"></div>
	<div class="hero-copy">
		<p class="eyebrow">
			<TypewriterText text={eyebrow} durationSec={3.2} />
		</p>
		<h1 id="hero-title">
			Software engineer, estudiante  y <span class="accent">gamer</span>
		</h1>
		<p class="lead">
			Desarrollador de software, estudiante, gamer y amante de la tecnología.
		</p>
		<div class="cta">
			<a class="btn btn-primary pixel-corners" href="/#projects">Ver proyectos</a>
			<a class="btn btn-ghost pixel-corners" href="/blog/">Leer blog</a>
		</div>
	</div>
	<figure>
		<Image src={pfp} alt="SebaSinMas" width="256" height="256" loading="eager" />
		<Image src={pfp2} alt="SebaSinMas pixel art" width="256" height="256" loading="eager" />

	</figure>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		margin-top: 2rem;
		padding: 2rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 50%, transparent);
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
		backdrop-filter: blur(18px);
	}

	@media (min-width: 900px) {
		.hero {
			flex-direction: row;
			align-items: center;
		}
	}

	.glow-blob {
		position: absolute;
		top: 0;
		right: 0;
		width: 16rem;
		height: 16rem;
		background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
		border-radius: 50%;
		filter: blur(80px);
		pointer-events: none;
		z-index: 0;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: clamp(0.62rem, 1.8vw, 0.72rem);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-secondary);
		min-height: 1.5em;
		overflow-x: auto;
		overflow-y: visible;
		-webkit-overflow-scrolling: touch;
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 3rem);
		line-height: 1.15;
		color: var(--color-on-surface);
	}

	.accent {
		color: var(--color-secondary);
	}

	.lead {
		margin: 0;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-on-surface-variant);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border: 1px solid transparent;
		cursor: pointer;
	}

	.btn-primary {
		background: var(--color-secondary);
		color: var(--color-on-secondary-fixed);
		border-color: var(--color-secondary);
	}

	.btn-primary:hover {
		background: var(--color-secondary-fixed);
		color: var(--color-on-secondary-fixed);
	}

	.btn-ghost {
		background: transparent;
		color: var(--color-secondary);
		border-color: var(--color-secondary);
	}

	.btn-ghost:hover {
		background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
	}

	figure{
		position: relative;
		width: 256px;
		transition: all 0.3s ease;
		overflow: hidden;
	}
	figure img:first-child{
		box-shadow:0 60px 60px -60px rgba(0, 0, 0, 0.5);
		border-radius: 4px;
		object-fit: cover;
		width: 100%;
		transition: all 0.3s ease;
	}
	figure img:last-child{
		position: absolute;
		width: 100%;
		bottom: 0;
		left: 0;
		right: 0;
		margin: auto;
		transform: translateY(10%);
		opacity: 0;
		transition: all 0.3s ease;
	}
	figure:hover{
		transform: perspective(1000px) rotateX(10deg) translateY(-5px) translateZ(0);

	}
	figure::before{
		content: '';
		position: absolute;
		bottom: 0;
		width: 100%;
		height: 100%;
		background-image: linear-gradient(to bottom, transparent 10%, rgba(0, 0, 0, 0.5)50%, rgba(0, 0, 0)95%);
		opacity: 0;
		transition: all 0.3s ease;
	}
	figure:hover::before{
		opacity: 1;
	}
	figure:hover img:last-child{
		opacity: 1;
		transform: translateY(0%) perspective(0);
	}
</style>
