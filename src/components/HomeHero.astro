---
import TypewriterText from './TypewriterText.astro';

const eyebrow = 'Sistema en línea // Usuario: SebaSinMas';
---

<section class="hero container glow-shadow pixel-corners" aria-labelledby="hero-title">
	<div class="glow-blob" aria-hidden="true"></div>
	<div class="hero-copy">
		<p class="eyebrow">
			<TypewriterText text={eyebrow} durationSec={3.2} />
		</p>
		<h1 id="hero-title">
			Desarrollador creativo y <span class="accent">UI engineer</span>
		</h1>
		<p class="lead">
			Experiencias digitales de alta fidelidad con precisión visual. Especializado en arquitecturas web modernas e
			interfaces inmersivas.
		</p>
		<div class="cta">
			<a class="btn btn-primary pixel-corners" href="#projects">Ver proyectos</a>
			<a class="btn btn-ghost pixel-corners" href="/blog/">Leer blog</a>
		</div>
	</div>
	<figure class="avatar-wrap pixel-corners">
		<img
			src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80"
			alt="Retrato representativo del portfolio"
			width="256"
			height="256"
			loading="eager"
		/>
	</figure>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		margin-top: 2rem;
		padding: 2rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 50%, transparent);
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
		backdrop-filter: blur(18px);
	}

	@media (min-width: 900px) {
		.hero {
			flex-direction: row;
			align-items: center;
		}
	}

	.glow-blob {
		position: absolute;
		top: 0;
		right: 0;
		width: 16rem;
		height: 16rem;
		background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
		border-radius: 50%;
		filter: blur(80px);
		pointer-events: none;
		z-index: 0;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-secondary);
		min-height: 1.4em;
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 3rem);
		line-height: 1.15;
		color: var(--color-on-surface);
	}

	.accent {
		color: var(--color-secondary);
	}

	.lead {
		margin: 0;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-on-surface-variant);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border: 1px solid transparent;
		cursor: pointer;
	}

	.btn-primary {
		background: var(--color-secondary);
		color: var(--color-on-secondary-fixed);
		border-color: var(--color-secondary);
	}

	.btn-primary:hover {
		background: var(--color-secondary-fixed);
		color: var(--color-on-secondary-fixed);
	}

	.btn-ghost {
		background: transparent;
		color: var(--color-secondary);
		border-color: var(--color-secondary);
	}

	.btn-ghost:hover {
		background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
	}

	.avatar-wrap {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		width: 12rem;
		height: 12rem;
		padding: 4px;
		margin: 0;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
		background: color-mix(in srgb, var(--color-surface-lowest) 80%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: var(--glow);
	}

	@media (min-width: 900px) {
		.avatar-wrap {
			width: 16rem;
			height: 16rem;
		}
	}

	.avatar-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
		mix-blend-mode: luminosity;
		opacity: 0.85;
		clip-path: var(--radius-pixel);
	}
</style>
