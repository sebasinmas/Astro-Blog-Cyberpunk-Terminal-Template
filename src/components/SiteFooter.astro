---
interface Props {
	/** `home`: sign-off al final. `page`: sign-off centrado sobre el divisor. */
	variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const year = new Date().getFullYear();
const copy = variant === 'page' ? `© ${year} SebaSinMas — Portfolio técnico // SYS_OK` : `© ${year} SebaSinMas — Portfolio técnico`;
---

<footer class:list={['m-container', 'site-footer', `site-footer--${variant}`]}>
	{
		variant === 'page' && (
			<div class="signoff signoff--top">
				<p>END OF LINE — Floppy not included. Synthwave batteries not included.</p>
			</div>
		)
	}
	{variant === 'page' && <div class="rule" role="presentation" />}
	<div class="bar">
		<p class="brand">SebaSinMas</p>
		<p class="copy">{copy}</p>
		<ul class="links">
			<li>
				<a href="https://github.com/sebasinmas" target="_blank" rel="noreferrer" aria-label="GitHub (abre en una pestaña nueva)"
					>GitHub</a
				>
			</li>
			<li>
				<a
					href="https://www.linkedin.com/in/sebastianbeni"
					target="_blank"
					rel="noreferrer"
					aria-label="LinkedIn (abre en una pestaña nueva)">LinkedIn</a
				>
			</li>
			<li>
				<a
					href="https://github.com/sebasinmas/Portfolio-Astro-Vps"
					target="_blank"
					rel="noreferrer"
					aria-label="Código fuente en GitHub (abre en una pestaña nueva)">Source</a
				>
			</li>
		</ul>
	</div>
	{
		variant === 'home' && (
			<div class="signoff">
				<p>END OF LINE — Floppy not included. Synthwave batteries not included.</p>
				<p>SYS_OK</p>
			</div>
		)
	}
</footer>

<style>
	.site-footer--page {
		padding-top: 112px;
		padding-bottom: 28px;
	}

	.rule {
		height: 1px;
		background: var(--m-line);
	}

	.signoff--top {
		justify-content: center;
		padding-bottom: 24px;
		text-align: center;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 100px;
	}

	.brand {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		color: var(--m-text);
	}

	.copy {
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-dim);
	}

	.links {
		display: flex;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 12px;
		color: var(--m-muted);
	}

	.links a {
		transition: color 0.2s ease;
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--m-accent);
	}

	.signoff {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: 28px;
		font-family: var(--m-font-code);
		font-size: 10px;
		color: var(--m-dim);
	}

	.signoff p {
		margin: 0;
	}

	@media (max-width: 760px) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
			padding-block: 28px;
		}

		.signoff {
			flex-direction: column;
			gap: 6px;
		}
	}
</style>
