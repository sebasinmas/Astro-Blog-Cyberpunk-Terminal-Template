---
const year = new Date().getFullYear();
---

<footer class="m-container site-footer">
	<div class="bar">
		<p class="brand">SebaSinMas</p>
		<p class="copy">&copy; {year} SebaSinMas — Portfolio técnico</p>
		<ul class="links">
			<li>
				<a href="https://github.com/sebasinmas" target="_blank" rel="noreferrer" aria-label="GitHub (abre en una pestaña nueva)"
					>GitHub</a
				>
			</li>
			<li>
				<a
					href="https://www.linkedin.com/in/sebastianbeni"
					target="_blank"
					rel="noreferrer"
					aria-label="LinkedIn (abre en una pestaña nueva)">LinkedIn</a
				>
			</li>
			<li>
				<a
					href="https://github.com/sebasinmas/Portfolio-Astro-Vps"
					target="_blank"
					rel="noreferrer"
					aria-label="Código fuente en GitHub (abre en una pestaña nueva)">Source</a
				>
			</li>
		</ul>
	</div>
	<div class="signoff">
		<p>END OF LINE — Floppy not included. Synthwave batteries not included.</p>
		<p>SYS_OK</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 0;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 100px;
	}

	.brand {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		color: var(--m-text);
	}

	.copy {
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-dim);
	}

	.links {
		display: flex;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 12px;
		color: var(--m-muted);
	}

	.links a {
		transition: color 0.2s ease;
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--m-accent);
	}

	.signoff {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: 28px;
		font-family: var(--m-font-code);
		font-size: 10px;
		color: var(--m-dim);
	}

	.signoff p {
		margin: 0;
	}

	@media (max-width: 760px) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
			padding-block: 28px;
		}

		.signoff {
			flex-direction: column;
			gap: 6px;
		}
	}
</style>
