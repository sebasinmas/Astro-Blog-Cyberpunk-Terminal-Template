---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DateTimeline from '../../components/DateTimeline.astro';
import Icon from '../../components/Icon.astro';
import clock from '../../assets/icons/clock-14.svg';
import arrowRead from '../../assets/icons/arrow-right-read.svg';
import { SITE_TITLE } from '../../consts';

const rawPosts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = rawPosts.map((post, index) => {
	const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
	const readingMin = Math.max(1, Math.ceil(words / 200));
	return {
		entry: post,
		log: `LOG ${String(rawPosts.length - index).padStart(3, '0')}`,
		readingTime: `${readingMin} MIN`,
	};
});
---

<BaseLayout
	title={`Bitácora — ${SITE_TITLE}`}
	description="Notas técnicas, arquitecturas, migraciones y experimentos en desarrollo de software y sistemas."
	navCurrent="blog"
>
	<div class="m-container blog-index">
		<header class="intro">
			<p class="eyebrow" data-reveal>
				<span class="signal" aria-hidden="true"></span>
				BITÁCORA / DATA LOG
			</p>
			<h1 data-reveal>Bitácora técnica</h1>
			<p class="lead" data-reveal>
				Registro personal de arquitectura, migraciones, optimización de sistemas y reflexiones.
			</p>
		</header>

		<section class="archive" aria-labelledby="archive-summary">
			<p class="summary" id="archive-summary" data-reveal>TOTAL DE ENTRADAS: {posts.length}</p>
			<ul class="entries" aria-label="Listado de artículos de la bitácora">
				{
					posts.map(({ entry, log, readingTime }) => (
						<li data-reveal>
							<a class="entry" href={`/blog/${entry.id}/`}>
								<div class="meta">
									<span class="reference">
										<span class="log">{log}</span>
										<span class="sep" aria-hidden="true" />
										<DateTimeline created={entry.data.pubDate} updated={entry.data.updatedDate} variant="inline" />
									</span>
									<span class="reading">
										<Icon src={clock} size={14} />
										{readingTime}
									</span>
								</div>
								<div class="preview">
									<h2>{entry.data.title}</h2>
									<p class="excerpt">{entry.data.description}</p>
									{entry.data.tags && entry.data.tags.length > 0 && (
										<ul class="topics" aria-label="Temas">
											{entry.data.tags.map((tag: string) => (
												<li>{tag}</li>
											))}
										</ul>
									)}
								</div>
								<div class="rule" role="presentation" />
								<div class="destination">
									<span class="path">/{entry.id.toLowerCase()}</span>
									<span class="read">
										Leer registro
										<Icon src={arrowRead} size={18} inset="-4.17% -5.89% -4.17% -4.17%" />
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</BaseLayout>

<script>
	import '../../scripts/page-motion';
</script>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		padding-block: 80px 48px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-accent);
	}

	.signal {
		width: 6px;
		height: 6px;
		background: var(--m-accent);
	}

	h1 {
		font-size: clamp(2.5rem, 6.2vw + 0.5rem, 4.25rem);
		line-height: 1.12;
		color: var(--m-text);
	}

	.lead {
		max-width: 760px;
		margin: 0;
		font-size: 17px;
		line-height: 1.65;
		color: var(--m-muted);
	}

	.archive {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.summary {
		margin: 0;
		padding-bottom: 8px;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-dim);
	}

	.entries {
		display: flex;
		flex-direction: column;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.entry {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 32px;
		background: var(--m-surface);
		border: 1px solid var(--m-line);
		border-radius: 8px;
		transition: border-color 0.25s ease;
	}

	.entry:hover,
	.entry:focus-visible {
		border-color: color-mix(in srgb, var(--m-accent) 55%, var(--m-line));
	}

	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--m-font-code);
	}

	.reference {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 20px;
	}

	.log {
		font-size: 11px;
		color: var(--m-accent);
		white-space: nowrap;
	}

	.sep {
		width: 1px;
		height: 12px;
		background: var(--m-line);
	}

	.reading {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		color: var(--m-dim);
		white-space: nowrap;
	}

	.preview {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	h2 {
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: normal;
		color: var(--m-text);
		transition: color 0.2s ease;
	}

	.entry:hover h2,
	.entry:focus-visible h2 {
		color: var(--m-accent);
	}

	.excerpt {
		max-width: 960px;
		margin: 0;
		font-size: 16px;
		line-height: 1.65;
		color: var(--m-muted);
	}

	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 4px 0 0;
		list-style: none;
	}

	.topics li {
		padding: 6px 9px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-muted);
	}

	.rule {
		height: 1px;
		background: var(--m-line);
	}

	.destination {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.path {
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-dim);
		overflow-wrap: anywhere;
	}

	.read {
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 14px;
		color: var(--m-accent);
		white-space: nowrap;
	}

	.read :global(.icon) {
		transition: transform 0.25s ease;
	}

	.entry:hover .read :global(.icon),
	.entry:focus-visible .read :global(.icon) {
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.intro {
			padding-block: 48px 32px;
		}

		.entry {
			padding: 20px;
		}

		.meta {
			flex-wrap: wrap;
		}
	}
</style>
