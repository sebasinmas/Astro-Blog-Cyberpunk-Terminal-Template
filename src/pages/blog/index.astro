---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Blog — ${SITE_TITLE}`} description="Artículos sobre desarrollo web, UI y Astro.">
	<div class="blog-index container">
		<header class="page-head">
			<h1>Blog</h1>
			<p>Notas técnicas, procesos y experimentos.</p>
		</header>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="post-card pixel-corners">
							<FormattedDate date={post.data.pubDate} />
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.blog-index {
		padding-top: 2rem;
		padding-bottom: 3rem;
	}

	.page-head {
		margin-bottom: 2rem;
		max-width: 36rem;
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		margin-bottom: 0.35rem;
		color: var(--color-on-surface);
	}

	.page-head p {
		margin: 0;
		color: var(--color-on-surface-variant);
		font-size: 1rem;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card {
		display: block;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, transparent);
		background: color-mix(in srgb, var(--color-surface) 55%, transparent);
		backdrop-filter: blur(10px);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.post-card:hover {
		border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-outline-variant));
		box-shadow: var(--glow);
	}

	.post-card :global(time) {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-outline);
	}

	h2 {
		font-size: 1.2rem;
		margin: 0.35rem 0 0.5rem;
		color: var(--color-secondary);
	}

	.post-card:hover h2 {
		color: var(--color-primary);
	}

	.post-card p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-on-surface-variant);
	}
</style>
