---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const rawPosts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = rawPosts.map((post) => {
	const words = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
	const readingMin = Math.max(1, Math.ceil(words / 200));
	return {
		...post,
		readingTime: `${readingMin} min`,
	};
});
---

<BaseLayout
	title={`Bitácora — ${SITE_TITLE}`}
	description="Notas técnicas, arquitecturas, migraciones y experimentos en desarrollo de software y sistemas."
>
	<div class="blog-index container">
		<header class="page-head">
			<div class="sys-status" aria-label="Estado del sistema">
				<span class="status-dot" aria-hidden="true"></span>
				<span class="status-label">SYS_ARCHIVE // OK</span>
				<span class="status-sep" aria-hidden="true">│</span>
				<span>{posts.length} {posts.length === 1 ? 'REGISTRO' : 'REGISTROS'}</span>
				<span class="status-sep" aria-hidden="true">│</span>
				<span>FEED: LIVE</span>
			</div>
			<h1>BITÁCORA TÉCNICA<span class="caret" aria-hidden="true"></span></h1>
			<p class="subtitle">
				Registro personal de arquitectura, migraciones, optimización de sistemas y reflexiones.
			</p>
			<div class="ascii-rule-wrap" role="presentation">
				<pre class="ascii-rule ascii-rule--narrow" aria-hidden="true">::: TAPE READY :::</pre>
				<pre class="ascii-rule ascii-rule--wide" aria-hidden="true">::: SYSTEM LOG ARCHIVE // SELECT ENTRY TO MOUNT :::</pre>
			</div>
		</header>

		<div class="feed-wrap">
			<ul class="post-feed" aria-label="Listado de artículos de la bitácora">
				{
					posts.map((post, index) => (
						<li>
							<a href={`/blog/${post.id}/`} class="log-card pixel-corners">
								<div class="log-card__head">
									<span class="log-id">LOG #{String(posts.length - index).padStart(2, '0')}</span>
									<span class="log-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="log-reading">⏱ {post.readingTime}</span>
								</div>
								<h2 class="log-title">{post.data.title}</h2>
								<p class="log-desc">{post.data.description}</p>
								{post.data.tags && post.data.tags.length > 0 && (
									<ul class="log-tags">
										{post.data.tags.map((tag: string) => (
											<li>#{tag}</li>
										))}
									</ul>
								)}
								<div class="log-foot">
									<span class="log-cmd">cat /syslog/{post.id}.md</span>
									<span class="log-action">
										LEER REGISTRO <span class="arrow" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</BaseLayout>

<style>
	.blog-index {
		padding-top: clamp(1.5rem, 4vw, 2.5rem);
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	.page-head {
		margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
		max-width: min(100%, 46rem);
	}

	.sys-status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		color: var(--color-neon-dim);
		margin-bottom: 0.75rem;
		padding: 0.25rem 0.6rem;
		background: color-mix(in srgb, var(--color-surface-lowest) 90%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-neon-dim) 50%, transparent);
	}

	.status-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		background: var(--color-neon-green);
		box-shadow: 0 0 8px var(--color-neon-green);
		animation: pulse-dot 1.5s infinite;
	}

	@keyframes pulse-dot {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.status-dot {
			animation: none;
		}
	}

	.status-label {
		color: var(--color-neon-green);
		font-weight: 700;
	}

	.status-sep {
		color: var(--color-outline-variant);
		opacity: 0.7;
	}

	h1 {
		font-size: clamp(1.85rem, 4.5vw, 2.75rem);
		margin: 0 0 0.5rem;
		color: var(--color-on-surface);
		display: flex;
		align-items: center;
		gap: 0.35rem;
		letter-spacing: 0.02em;
		text-shadow:
			0 0 10px rgba(5, 217, 232, 0.3),
			0 0 24px rgba(57, 255, 20, 0.15);
	}

	.caret {
		display: inline-block;
		width: 0.4rem;
		height: 0.85em;
		background: var(--color-neon-green);
		box-shadow: 0 0 12px rgba(57, 255, 20, 0.5);
		animation: caret-blink 1s steps(1, end) infinite;
	}

	@keyframes caret-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
			opacity: 1;
		}
	}

	.subtitle {
		margin: 0;
		color: var(--color-on-surface-variant);
		font-size: clamp(0.95rem, 2.4vw, 1.05rem);
		line-height: 1.55;
	}

	.ascii-rule-wrap {
		margin-top: 1.25rem;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior-x: contain;
	}

	.ascii-rule {
		margin: 0;
		font-family: var(--font-mono);
		font-size: clamp(0.58rem, 2.4vw, 0.68rem);
		line-height: 1.35;
		color: var(--color-neon-dim);
		text-shadow: 0 0 6px rgba(0, 143, 17, 0.25);
		white-space: pre;
		width: max-content;
		max-width: none;
	}

	.ascii-rule--wide {
		display: none;
	}

	@media (min-width: 640px) {
		.ascii-rule--narrow {
			display: none;
		}

		.ascii-rule--wide {
			display: block;
		}
	}

	.feed-wrap {
		width: 100%;
	}

	.post-feed {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.log-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: clamp(1.2rem, 3vw, 1.5rem);
		min-height: 44px;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 35%, var(--color-outline-variant));
		background: color-mix(in srgb, var(--color-surface-lowest) 92%, transparent);
		backdrop-filter: blur(12px);
		border-radius: 0;
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.22s ease;
	}

	.log-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			0deg,
			transparent,
			transparent 2px,
			rgba(0, 0, 0, 0.12) 2px,
			rgba(0, 0, 0, 0.12) 3px
		);
		pointer-events: none;
		opacity: 0.35;
	}

	.log-card:hover {
		border-color: var(--color-secondary);
		box-shadow:
			0 0 24px rgba(5, 217, 232, 0.18),
			0 0 40px rgba(255, 42, 109, 0.08);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.log-card:hover {
			transform: none;
		}
	}

	.log-card__head {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.log-id {
		padding: 0.12rem 0.45rem;
		background: rgba(57, 255, 20, 0.1);
		border: 1px solid color-mix(in srgb, var(--color-neon-green) 50%, transparent);
		color: var(--color-neon-green);
		font-weight: 700;
		font-size: 0.65rem;
		letter-spacing: 0.08em;
	}

	.log-date {
		color: var(--color-outline);
	}

	.log-reading {
		margin-left: auto;
		color: var(--color-neon-amber);
		font-size: 0.7rem;
	}

	.log-title {
		position: relative;
		z-index: 1;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 3vw, 1.55rem);
		line-height: 1.25;
		margin: 0;
		color: var(--color-secondary);
		transition:
			color 0.18s ease,
			text-shadow 0.18s ease;
	}

	.log-card:hover .log-title {
		color: var(--color-on-surface);
		text-shadow:
			-1px 0 0 rgba(255, 42, 109, 0.5),
			1px 0 0 rgba(5, 217, 232, 0.4),
			0 0 14px rgba(57, 255, 20, 0.25);
	}

	.log-desc {
		position: relative;
		z-index: 1;
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.55;
		color: var(--color-on-surface-variant);
	}

	.log-tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.log-tags li {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		padding: 0.15rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 30%, var(--color-outline-variant));
		background: color-mix(in srgb, var(--color-container-high) 80%, transparent);
		color: var(--color-secondary);
		border-radius: 0;
	}

	.log-foot {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px dashed color-mix(in srgb, var(--color-outline-variant) 80%, transparent);
		font-family: var(--font-mono);
		font-size: 0.74rem;
	}

	.log-cmd {
		color: var(--color-neon-dim);
		font-size: 0.65rem;
	}

	.log-action {
		color: var(--color-secondary);
		font-weight: 600;
		letter-spacing: 0.08em;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition:
			color 0.15s ease,
			transform 0.15s ease;
	}

	.log-card:hover .log-action {
		color: var(--color-neon-green);
	}

	.arrow {
		transition: transform 0.2s ease;
	}

	.log-card:hover .arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.log-card:hover .arrow {
			transform: none;
		}
	}
</style>
