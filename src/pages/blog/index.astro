---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
	(a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`Blog — ${SITE_TITLE}`} description="Artículos sobre desarrollo web, UI y Astro.">
	<div class="blog-index container">
		<header class="page-head">
			<h1>BLOG<span class="caret" aria-hidden="true"></span></h1>
			<p>Notas técnicas, procesos y experimentos.</p>
			<div class="ascii-rule-wrap">
				<pre class="ascii-rule ascii-rule--narrow" aria-hidden="true">::: TAPE READY :::</pre>
				<pre class="ascii-rule ascii-rule--wide" aria-hidden="true">::: DATA TAPE READY — INSERT CASSETTE TO CONTINUE :::</pre>
			</div>
		</header>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="post-card pixel-corners" data-gag={`mount /posts/${post.id}`}>
							<FormattedDate date={post.data.pubDate} />
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.blog-index {
		padding-top: 2rem;
		padding-bottom: 3rem;
	}

	.page-head {
		margin-bottom: 2rem;
		max-width: min(100%, 38rem);
	}

	h1 {
		font-size: clamp(1.85rem, 4vw, 2.65rem);
		margin-bottom: 0.35rem;
		color: var(--color-on-surface);
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.caret {
		display: inline-block;
		width: 0.4rem;
		height: 0.85em;
		background: var(--color-neon-green);
		box-shadow: 0 0 12px rgba(57, 255, 20, 0.45);
		animation: caret-blink 1s steps(1, end) infinite;
	}

	@keyframes caret-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
			opacity: 1;
		}
	}

	.page-head p {
		margin: 0;
		color: var(--color-on-surface-variant);
		font-size: 1rem;
	}

	.ascii-rule-wrap {
		margin-top: 1rem;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior-x: contain;
	}

	.ascii-rule {
		margin: 0;
		font-family: var(--font-mono);
		font-size: clamp(0.58rem, 2.6vw, 0.68rem);
		line-height: 1.35;
		color: var(--color-neon-dim);
		text-shadow: 0 0 6px rgba(0, 143, 17, 0.25);
		white-space: pre;
		width: max-content;
		max-width: none;
	}

	.ascii-rule--wide {
		display: none;
	}

	@media (min-width: 640px) {
		.ascii-rule--narrow {
			display: none;
		}

		.ascii-rule--wide {
			display: block;
		}
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card {
		position: relative;
		display: block;
		padding: clamp(1.15rem, 3vw, 1.35rem);
		min-height: 44px;
		border: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
		background: color-mix(in srgb, var(--color-surface) 62%, transparent);
		backdrop-filter: blur(10px);
		border-radius: 0;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.22s ease;
	}

	.post-card:hover {
		border-color: color-mix(in srgb, var(--color-secondary) 55%, var(--color-primary));
		box-shadow: var(--glow);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card:hover {
			transform: none;
		}
	}

	@media (min-width: 768px) {
		.post-card:hover::before {
			content: attr(data-gag);
			position: absolute;
			right: 1rem;
			bottom: 1rem;
			font-family: var(--font-mono);
			font-size: 0.58rem;
			color: var(--color-neon-dim);
			pointer-events: none;
			opacity: 0.85;
		}
	}

	.post-card :global(time) {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-outline);
	}

	h2 {
		font-family: var(--font-display);
		font-size: 1.28rem;
		margin: 0.35rem 0 0.5rem;
		color: var(--color-secondary);
		transition:
			color 0.18s ease,
			text-shadow 0.18s ease;
	}

	.post-card:hover h2 {
		color: var(--color-on-surface);
		text-shadow:
			-1px 0 0 rgba(255, 42, 109, 0.45),
			1px 0 0 rgba(5, 217, 232, 0.35);
	}

	.post-card p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-on-surface-variant);
	}
</style>
