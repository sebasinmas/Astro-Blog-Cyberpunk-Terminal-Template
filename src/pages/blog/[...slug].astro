---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveBlogImage } from '../../utils/resolveContentImage';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post: CollectionEntry<'blog'>) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const readingTime = `${readingMinutes} min`;

const imageRef = post.data.image ?? post.data.heroImage;
const heroImage = imageRef ? resolveBlogImage(imageRef) : undefined;
---

<BaseLayout
	title={`${post.data.title} — Bitácora`}
	description={post.data.description}
	image={`/open-graph/blog/${post.id}.png`}
	type="article"
	publishedDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	tags={post.data.tags}
>
	<ArticleLayout
		variant="blog"
		title={post.data.title}
		description={post.data.description}
		pubDate={post.data.pubDate}
		updatedDate={post.data.updatedDate}
		heroImage={heroImage}
		crumbHref="/blog/"
		crumbLabel="Bitácora"
		backHref="/blog/"
		backLabel="Volver a la bitácora"
		readingTime={readingTime}
		tags={post.data.tags}
	>
		<Content />
	</ArticleLayout>
</BaseLayout>
