---
import BaseLayout from '../layouts/BaseLayout.astro';
import arrowRightDark from '../assets/icons/arrow-right-dark.svg';
import arrowRightLight from '../assets/icons/arrow-right-light.svg';
import { SITE_TITLE } from '../consts';

const title = `404 — ${SITE_TITLE}`;
const description = 'Ruta no encontrada.';
---

<BaseLayout {title} {description} theme="modern">
	<div class="m-container">
		<section class="not-found" aria-labelledby="err-title">
			<p class="eyebrow" data-reveal>
				<span class="signal" aria-hidden="true"></span>
				ERROR 404 / RUTA NO ENCONTRADA
			</p>
			<h1 id="err-title" data-reveal>
				Esta página no existe<span class="accent">.</span>
			</h1>
			<p class="lead" data-reveal>
				La URL solicitada no está en este sitio. Puede que el enlace esté roto o que la página se haya movido.
			</p>
			<pre class="trace" aria-hidden="true" data-reveal>$ GET /requested/path
! ENOENT: no such file or directory
$ echo $?
127</pre>
			<div class="actions" data-reveal>
				<a class="action primary" href="/">
					Volver al inicio
					<img src={arrowRightDark.src} width="18" height="18" alt="" />
				</a>
				<a class="action secondary" href="/blog/">
					Ir a la bitácora
					<img src={arrowRightLight.src} width="18" height="18" alt="" />
				</a>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	import '../scripts/page-motion';
</script>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 28px;
		padding-block: 96px 80px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-accent);
	}

	.signal {
		width: 6px;
		height: 6px;
		background: var(--m-accent);
	}

	h1 {
		max-width: 12em;
		font-size: clamp(2.5rem, 6.2vw + 0.5rem, 4.25rem);
		line-height: 1.12;
		color: var(--m-text);
		text-wrap: balance;
	}

	.accent {
		color: var(--m-accent);
	}

	.lead {
		max-width: 650px;
		margin: 0;
		font-size: 17px;
		line-height: 1.65;
		color: var(--m-muted);
	}

	.trace {
		margin: 0;
		padding: 20px 24px;
		background: var(--m-surface);
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-family: var(--m-font-code);
		font-size: 12px;
		line-height: 1.7;
		color: var(--m-dim);
		overflow-x: auto;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 4px;
	}

	.action {
		display: inline-flex;
		align-items: center;
		gap: 24px;
		height: 50px;
		padding-inline: 20px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-size: 14px;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.action img {
		transition: transform 0.25s ease;
	}

	.action:hover img,
	.action:focus-visible img {
		transform: translateX(4px);
	}

	.primary {
		background: var(--m-accent);
		border-color: var(--m-accent);
		color: var(--m-on-accent);
	}

	.primary:hover {
		background: color-mix(in srgb, var(--m-accent) 82%, white);
		border-color: color-mix(in srgb, var(--m-accent) 82%, white);
		color: var(--m-on-accent);
	}

	.secondary {
		color: var(--m-text);
	}

	.secondary:hover {
		border-color: var(--m-accent);
		color: var(--m-text);
	}

	@media (max-width: 640px) {
		.not-found {
			padding-block: 56px;
		}
	}
</style>
