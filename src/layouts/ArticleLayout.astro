---
import Image from 'astro/components/Image.astro';
import type { ImageMetadata } from 'astro';
import DateTimeline from '../components/DateTimeline.astro';
import Icon from '../components/Icon.astro';
import clock from '../assets/icons/clock-12.svg';
import arrowLeftBlog from '../assets/icons/arrow-left-18.svg';
import arrowLeftProject from '../assets/icons/arrow-left-11.svg';
import arrowContact from '../assets/icons/arrow-contact.svg';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string | ImageMetadata;
	crumbHref?: string;
	crumbLabel?: string;
	backHref?: string;
	backLabel?: string;
	tags?: readonly string[];
	variant?: 'blog' | 'project';
	readingTime?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	crumbHref = '/blog/',
	crumbLabel = 'Bitácora',
	backHref,
	backLabel = 'Volver',
	tags,
	variant = crumbHref.includes('/blog') ? 'blog' : 'project',
	readingTime,
} = Astro.props;

const hasHero = heroImage !== undefined && heroImage !== null;
const heroIsRemote = typeof heroImage === 'string';
const isBlog = variant === 'blog';
const backTarget = backHref ?? crumbHref;
// El diseño usa una flecha de 18px en la bitácora y una de 11px en proyectos.
const backArrow = isBlog
	? { src: arrowLeftBlog, size: 18, inset: undefined }
	: { src: arrowLeftProject, size: 11, inset: '-6.82% -6.82% -6.82% -9.64%' };
---

{/* Progreso de lectura: lo anima `scripts/reading-progress.ts` (GSAP + ScrollTrigger). */}
<div class="reading-progress" aria-hidden="true">
	<div class="reading-progress__bar" data-reading-progress></div>
</div>

<article class={`article m-container article--${variant}`}>
	<header class="article-head">
		{
			backHref && (
				<nav aria-label="Navegación de retorno" data-reveal>
					<a href={backHref} class="back-link">
						<Icon src={backArrow.src} size={backArrow.size} inset={backArrow.inset} />
						<span>{backLabel}</span>
					</a>
				</nav>
			)
		}

		<div class="presentation">
			<div class="meta" data-reveal>
				<span class="doc-type">
					<span class="signal" aria-hidden="true"></span>
					{isBlog ? 'SYS.LOG // ENTRY' : 'SYS.PROJECT // SPEC'}
				</span>
				{
					!isBlog && (
						<a href={crumbHref} class="crumb">
							{crumbLabel}
						</a>
					)
				}
				<span class="sep" aria-hidden="true"></span>
				<DateTimeline created={pubDate} updated={updatedDate} />
				{
					readingTime && (
						<span class="reading">
							<Icon src={clock} size={12} />
							{readingTime}
						</span>
					)
				}
			</div>

			<h1 data-reveal>{title}</h1>
			<p class="deck" data-reveal>{description}</p>

			{
				tags && tags.length > 0 && (
					<ul class="tags" aria-label="Etiquetas del artículo" data-reveal>
						{tags.map((t) => (
							<li>#{t}</li>
						))}
					</ul>
				)
			}

		</div>

		<div class="marker" aria-hidden="true" data-reveal>
			<span class="line"></span>
			<span class="label">{isBlog ? 'TRANSMISSION_START' : 'SPECIFICATION_START // ARCHIVE'}</span>
			<span class="line"></span>
		</div>
	</header>

	<div class="body">
		{
			hasHero &&
				(heroIsRemote ? (
					<img class="hero-img" src={heroImage as string} alt={title} loading="eager" />
				) : (
					<Image class="hero-img" src={heroImage as ImageMetadata} alt={title} loading="eager" />
				))
		}

		<div class="prose" data-reading-content>
			<slot />
		</div>

		<footer class="article-footer">
			<div class="rule" role="presentation"></div>
			<p class="eof" aria-hidden="true">
				{isBlog ? '::: FIN DE TRANSMISIÓN // SYSLOG_EOF :::' : '::: FIN DE TRANSMISIÓN // SPEC_EOF :::'}
			</p>
			<div class="actions">
				<a href={backTarget} class="back-link">
					<Icon src={backArrow.src} size={backArrow.size} inset={backArrow.inset} />
					<span>{backLabel}</span>
				</a>
				<a href="/#contact" class="contact-btn">
					Contacto / Feedback
					<Icon src={arrowContact} size={18} inset="-2.95% -5.89% -2.95% 0" />
				</a>
			</div>
		</footer>
	</div>
</article>

<script>
	import '../scripts/page-motion';
	import '../scripts/reading-progress';
</script>

<style>
	.article-head {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 40px;
		padding-block: 48px;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-size: 14px;
		color: var(--m-accent);
		transition: color 0.2s ease;
	}

	.back-link :global(.icon) {
		transition: transform 0.25s ease;
	}

	.back-link:hover :global(.icon),
	.back-link:focus-visible :global(.icon) {
		transform: translateX(-4px);
	}

	.back-link:hover {
		color: var(--m-text);
	}

	.presentation {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-dim);
	}

	.doc-type {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--m-accent);
	}

	.signal {
		width: 6px;
		height: 6px;
		background: var(--m-accent);
	}

	.crumb {
		color: var(--m-accent);
	}

	.sep {
		width: 1px;
		height: 12px;
		background: var(--m-line);
	}

	.reading {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	h1 {
		font-size: clamp(2.5rem, 6.2vw + 0.5rem, 4.25rem);
		line-height: 1.12;
		color: var(--m-text);
		text-wrap: balance;
	}

	.deck {
		max-width: 800px;
		margin: 0;
		font-size: 18px;
		line-height: 1.7;
		color: var(--m-muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 6px 9px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-family: var(--m-font-code);
		font-size: 11px;
		color: var(--m-muted);
	}

	/* Barra de progreso de lectura: fija arriba, se escala en X desde la izquierda. */
	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 90;
		height: 3px;
		pointer-events: none;
	}

	.reading-progress__bar {
		width: 100%;
		height: 100%;
		background: var(--m-accent);
		transform: scaleX(0);
		transform-origin: left center;
		will-change: transform;
	}

	@media print {
		.reading-progress {
			display: none;
		}
	}

	.marker {
		display: flex;
		align-items: center;
		gap: 24px;
		font-family: var(--m-font-code);
		font-size: 10px;
		color: var(--m-dim);
	}

	.marker .line {
		flex: 1 1 0;
		height: 1px;
		background: var(--m-line);
	}

	.marker .label {
		white-space: nowrap;
	}

	/* Columna de lectura de 760px */
	.body {
		display: flex;
		flex-direction: column;
		gap: 56px;
		width: 100%;
		max-width: 760px;
		margin-inline: auto;
	}

	.hero-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		aspect-ratio: 760 / 346;
		object-fit: cover;
		object-position: top;
	}

	.article--blog .hero-img {
		aspect-ratio: 760 / 445;
	}

	.prose {
		font-size: 17px;
		line-height: 1.8;
		color: var(--m-muted);
	}

	.prose > :global(* + *) {
		margin-top: 24px;
	}

	.prose :global(h2) {
		margin-top: 56px;
		font-size: 32px;
		line-height: 1.25;
		color: var(--m-text);
		text-wrap: balance;
	}

	.prose > :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(h3) {
		margin-top: 40px;
		font-size: 23px;
		line-height: 1.25;
		color: var(--m-text);
		text-wrap: balance;
	}

	.prose :global(h4) {
		margin-top: 32px;
		font-size: 18px;
		font-weight: 500;
		line-height: 1.3;
		color: var(--m-text);
	}

	.prose :global(p) {
		margin-bottom: 0;
		text-wrap: pretty;
	}

	.prose :global(strong) {
		font-weight: 600;
		color: var(--m-text);
	}

	.prose :global(a) {
		color: var(--m-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.2s ease;
	}

	.prose :global(a:hover) {
		color: var(--m-text);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 0;
		padding-left: 1.4rem;
	}

	.prose :global(li + li) {
		margin-top: 8px;
	}

	.prose :global(li::marker) {
		color: var(--m-dim);
	}

	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border-radius: 4px;
	}

	/* Markdown pega la imagen al texto siguiente dentro del mismo <p> */
	.prose :global(p > img) {
		margin-bottom: 24px;
	}

	.prose :global(img + em),
	.prose :global(figcaption) {
		font-family: var(--m-font-code);
		font-size: 12px;
		color: var(--m-dim);
	}

	.prose :global(figure) {
		margin-inline: 0;
	}

	.prose :global(figure img) {
		margin-bottom: 12px;
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		background: var(--m-surface-2);
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-family: var(--m-font-code);
		font-size: 0.85em;
		color: var(--m-text);
	}

	.prose :global(pre) {
		padding: 20px;
		overflow-x: auto;
		background: var(--m-surface);
		border: 1px solid var(--m-line);
		border-radius: 4px;
		line-height: 1.6;
	}

	.prose :global(pre code) {
		padding: 0;
		background: none;
		border: 0;
		font-size: 14px;
	}

	.prose :global(blockquote) {
		margin-inline: 0;
		padding: 4px 0 4px 20px;
		border-left: 2px solid var(--m-accent);
		color: var(--m-muted);
	}

	.prose :global(blockquote > * + *) {
		margin-top: 12px;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 15px;
		border: 1px solid var(--m-line);
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 10px 14px;
		text-align: left;
		border-bottom: 1px solid var(--m-line);
	}

	.prose :global(th) {
		font-family: var(--m-font-code);
		font-size: 12px;
		font-weight: 400;
		background: var(--m-surface);
		color: var(--m-accent);
	}

	.prose :global(kbd) {
		padding: 0.1em 0.45em;
		border: 1px solid var(--m-line);
		border-bottom-width: 2px;
		border-radius: 4px;
		background: var(--m-surface);
		font-family: var(--m-font-code);
		font-size: 0.8em;
		color: var(--m-text);
	}

	.prose :global(hr) {
		height: 1px;
		margin-block: 40px;
		border: 0;
		background: var(--m-line);
	}

	.article-footer {
		display: flex;
		flex-direction: column;
		gap: 28px;
		margin-top: -8px;
	}

	.rule {
		height: 1px;
		background: var(--m-line);
	}

	.eof {
		margin: 0;
		font-family: var(--m-font-code);
		font-size: 11px;
		text-align: center;
		color: var(--m-dim);
	}

	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.contact-btn {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		height: 48px;
		padding-inline: 20px;
		border: 1px solid var(--m-line);
		border-radius: 4px;
		font-size: 14px;
		color: var(--m-accent);
		white-space: nowrap;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.contact-btn :global(.icon) {
		transition: transform 0.25s ease;
	}

	.contact-btn:hover,
	.contact-btn:focus-visible {
		border-color: var(--m-accent);
		color: var(--m-text);
	}

	.contact-btn:hover :global(.icon),
	.contact-btn:focus-visible :global(.icon) {
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.article-head {
			gap: 32px;
			padding-block: 32px;
		}

		.prose {
			font-size: 16px;
		}

		.prose :global(h2) {
			font-size: 26px;
		}

		.prose :global(h3) {
			font-size: 21px;
		}

		.actions {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
		}

		.marker .label {
			white-space: normal;
			text-align: center;
		}
	}
</style>
