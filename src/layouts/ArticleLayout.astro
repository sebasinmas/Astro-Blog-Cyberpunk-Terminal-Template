---
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<article class="article container">
	<header class="article-head">
		<p class="meta">
			<a href="/blog/">Blog</a>
			<span aria-hidden="true"> / </span>
			<FormattedDate date={pubDate} />
		</p>
		<h1>{title}<span class="heading-caret" aria-hidden="true"></span></h1>
		<p class="deck">{description}</p>
		{
			updatedDate && (
				<p class="updated">
					Actualizado el <FormattedDate date={updatedDate} />
				</p>
			)
		}
	</header>
	{heroImage && <img class="hero-img pixel-corners" src={heroImage} alt="" loading="eager" />}
	<div class="prose">
		<slot />
	</div>
</article>

<style>
	.article {
		padding-top: clamp(1.25rem, 4vw, 2rem);
		padding-bottom: clamp(2rem, 6vw, 3rem);
		width: 100%;
		min-width: 0;
	}

	.article-head {
		max-width: 40rem;
		margin-bottom: 1.5rem;
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-on-surface-variant);
	}

	.meta a {
		color: var(--color-secondary);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: text-shadow 0.15s ease;
	}

	.meta a:hover {
		text-shadow: 0 0 10px rgba(5, 217, 232, 0.45);
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		margin: 0.5rem 0;
		line-height: 1.15;
		color: var(--color-on-surface);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem;
	}

	.heading-caret {
		display: inline-block;
		width: 0.4rem;
		height: 0.85em;
		align-self: center;
		background: var(--color-secondary);
		box-shadow: 0 0 12px rgba(5, 217, 232, 0.45);
		animation: caret-blink 1s steps(1, end) infinite;
	}

	@keyframes caret-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.heading-caret {
			animation: none;
			opacity: 1;
		}
	}

	.deck {
		margin: 0;
		font-size: 1.05rem;
		color: var(--color-on-surface-variant);
	}

	.updated {
		margin: 0.75rem 0 0;
		font-size: 0.85rem;
		font-style: italic;
		color: var(--color-outline);
	}

	.hero-img {
		width: 100%;
		max-height: 22rem;
		object-fit: cover;
		border: 1px solid color-mix(in srgb, var(--color-secondary) 35%, var(--color-outline-variant));
		margin-bottom: 2rem;
		border-radius: 0;
		box-shadow: 0 0 24px rgba(255, 42, 109, 0.08);
	}

	.prose {
		max-width: 40rem;
		color: var(--color-on-surface-variant);
		font-size: 1rem;
		line-height: 1.7;
	}

	.prose :global(h2),
	.prose :global(h3) {
		font-family: var(--font-display);
		color: var(--color-on-surface);
		margin: 2rem 0 0.75rem;
		font-size: 1.15rem;
		text-shadow: 0 0 10px rgba(57, 255, 20, 0.15);
	}

	.prose :global(p) {
		margin: 0 0 1rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1rem 1.25rem;
		padding: 0;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.88em;
		padding: 0.1em 0.35em;
		background: var(--color-container-high);
		border: 1px solid color-mix(in srgb, var(--color-secondary) 25%, var(--color-outline-variant));
		border-radius: 0;
		color: var(--color-neon-green);
		text-shadow: 0 0 6px rgba(57, 255, 20, 0.2);
	}

	.prose :global(pre) {
		padding: 1rem;
		overflow-x: auto;
		background: var(--color-surface-lowest);
		border: 1px solid color-mix(in srgb, var(--color-primary) 25%, var(--color-outline-variant));
		border-radius: 0;
		box-shadow: inset 0 0 40px rgba(5, 217, 232, 0.04);
	}

	.prose :global(pre code) {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		text-shadow: none;
	}

	.prose :global(blockquote) {
		margin: 1rem 0;
		padding-left: 1rem;
		border-left: 3px solid var(--color-primary);
		color: var(--color-on-surface);
		box-shadow: inset 8px 0 24px -16px rgba(255, 42, 109, 0.35);
	}

	.prose :global(a) {
		color: var(--color-secondary);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: text-shadow 0.15s ease;
	}

	.prose :global(a:hover) {
		text-shadow: 0 0 10px rgba(5, 217, 232, 0.45);
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--color-outline-variant);
		border-radius: 0;
	}
</style>
