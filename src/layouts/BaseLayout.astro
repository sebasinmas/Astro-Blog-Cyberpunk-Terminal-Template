---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import type { ImageMetadata } from 'astro';

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	type?: 'website' | 'article';
	publishedDate?: Date;
	updatedDate?: Date;
	tags?: readonly string[];
	/** Variante de cabecera/pie (`home` = landing). */
	chrome?: 'home' | 'page';
	/** Destino de navegación activo. */
	navCurrent?: 'projects' | 'blog' | 'contact';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	publishedDate,
	updatedDate,
	tags,
	chrome = 'page',
	navCurrent,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedDate={publishedDate}
			updatedDate={updatedDate}
			tags={tags}
		/>
		<script is:inline>
			document.documentElement.classList.add('m-js');
			// Red de seguridad: si el JS de animación no carga, el contenido no queda oculto.
			setTimeout(() => document.documentElement.classList.remove('m-js'), 4000);
		</script>
	</head>
	<body class="theme-modern">
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<SiteHeader variant={chrome} current={navCurrent} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter variant={chrome} />
	</body>
</html>
