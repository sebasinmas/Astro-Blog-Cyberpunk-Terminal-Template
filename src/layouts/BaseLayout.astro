---
import BaseHead from '../components/BaseHead.astro';
import AppHeader from '../components/AppHeader.astro';
import AppFooter from '../components/AppFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import type { ImageMetadata } from 'astro';

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	type?: 'website' | 'article';
	publishedDate?: Date;
	updatedDate?: Date;
	tags?: readonly string[];
	/** `modern`: rediseño de la landing. `terminal`: estilo CRT original. */
	theme?: 'terminal' | 'modern';
	/** Solo tema `modern`: variante de cabecera/pie (`home` = landing). */
	chrome?: 'home' | 'page';
	/** Solo tema `modern`: destino de navegación activo. */
	navCurrent?: 'projects' | 'blog' | 'contact';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	publishedDate,
	updatedDate,
	tags,
	theme = 'terminal',
	chrome = 'page',
	navCurrent,
} = Astro.props;
const modern = theme === 'modern';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedDate={publishedDate}
			updatedDate={updatedDate}
			tags={tags}
		/>
		{
			modern && (
				<script is:inline>
					document.documentElement.classList.add('m-js');
					// Red de seguridad: si el JS de animación no carga, el contenido no queda oculto.
					setTimeout(() => document.documentElement.classList.remove('m-js'), 4000);
				</script>
			)
		}
	</head>
	{
		modern ? (
			<body class="theme-modern">
				<a class="skip-link" href="#main">Saltar al contenido</a>
				<SiteHeader variant={chrome} current={navCurrent} />
				<main id="main">
					<slot />
				</main>
				<SiteFooter variant={chrome} />
			</body>
		) : (
			<body class="crt-grid">
				<div class="crt-vignette" aria-hidden="true" />
				<div class="crt-overlay" aria-hidden="true" />
				<a class="skip-link" href="#main">Saltar al contenido</a>
				<AppHeader />
				<main id="main" class="page-main relative z-[1] flex flex-col gap-0 pb-8">
					<slot />
				</main>
				<AppFooter />
			</body>
		)
	}
</html>
